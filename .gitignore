# CONDUCTOR — project-level data (contains SQLite DB)
.conductor/

# Claude Code — local only (not shared)
.claude/settings.local.json
.claude/worktrees/
.claude/.DS_Store
.claude/checkpoints.log

# Secrets
.env
*.env

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Tool caches + coverage artifacts.
# A gap-closure, not an instance fix: the caches are currently invisible only
# because each tool writes its own nested .gitignore — that is the tool's
# choice, not ours, and a tool-version bump could start exposing them. The
# 2026-07-23 explicit-path-list rule constrains the OPERATOR; this constrains
# the FILE SET, so a future `git add -A` slip cannot sweep them in.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# LaTeX render artefacts (journal 2026-05-16: deliberately not committed)
header.tex
*.aux
*.toc
.venv/
venv/

# SQLite
*.db
*.db-journal
*.db-wal
*.db-shm

# macOS
.DS_Store

# Runtime / generated data
/data/
data/cache/
/logs/
/output/
/state/
scripts/paper_trading/logs/

# Reference (v13 source, not committed)
/reference

# Reference PDFs (large books, not committed; markdown is fine)
docs/references/*.pdf

# Temp config files
obsidian_on.json
.conductor/memory/*.db

# Backup / temp artifacts (state restore-points, admin-script backups)
*.bak
*.bak.*
*.tmp

# Mini-local production config override (Layer-2 --config; never committed)
state/prod_overrides.json

# FRL research cache (rebuildable from Polygon API; ledger/runs ARE tracked)
research/cache/*
!research/cache/.gitkeep

# Mini-generated analysis outputs (weekly_metrics, attribution tooling) — rsync
# territory, not git: a git-side update would be reverted by the next
# sync_from_mini.sh --delete run. House rule: rsync for machine-generated state,
# git for human-written documents.
docs/analysis/
